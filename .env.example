# Copy to .env and adjust. NEVER commit .env (it may contain secrets).
APP_NAME=Security Platform
ENVIRONMENT=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# Step 10: host interfaces the published ports are bound to. The loopback
# default means nothing is reachable from another machine until an operator
# deliberately opts in. Put a TLS-terminating reverse proxy in front and set
# these to 0.0.0.0 (or a specific address) for a real deployment.
API_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

# Database (used to build DATABASE_URL for the backend + postgres container)
POSTGRES_DB=security_platform
POSTGRES_USER=secuser
POSTGRES_PASSWORD=changeme_in_env
POSTGRES_PORT=5432

LOG_LEVEL=INFO

# Must be replaced with a strong random value in production.
SECRET_KEY=CHANGE_ME_dev_only

# Step 20: authentication foundation. Enforcement activates once a user
# exists; REQUIRE_AUTH=true disables the empty-table bootstrap mode.
# Step 10: REQUIRE_AUTH=true is now MANDATORY when ENVIRONMENT=production or
# ENVIRONMENT=staging — startup fails fast otherwise, because the
# unauthenticated bootstrap can create the first administrator. Set it true
# for anything reachable.
REQUIRE_AUTH=false
ACCESS_TOKEN_MINUTES=15

# Step 14: explicit Nmap authorization scope (comma-separated CIDRs).
# A scan target must fall inside one of these networks; everything else
# is refused with 403. Default is loopback only. Widen deliberately per
# deployment (e.g. lab LANs you own) — never by default.
SCAN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# Step 21: maximum addresses per discovery request (conservative default
# keeps discoveries loopback-scale; lower per deployment, raise only with
# authorization covering the wider scope).
DISCOVERY_MAX_ADDRESSES=256

# Step 26: live event-connector configuration. All empty by default
# (secure default: nothing is connected). File paths point at local
# EVE/log files the operator provisions; API credentials come only
# from the environment and are never returned by any endpoint.
SURICATA_EVE_PATH=
ZEEK_LOG_PATH=
WAZUH_API_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=

# Step 27: controlled outbound HTTP for the connectors above. Defaults are
# safe: hosts must match these values (destination allow-list built from
# them only), redirects are never followed, TLS verification stays on.
DEFENDER_API_ENDPOINT=https://graph.microsoft.com/v1.0
DEFENDER_AUTHORITY=https://login.microsoftonline.com
CONNECTOR_TIMEOUT_SECONDS=10
CONNECTOR_MAX_RESPONSE_BYTES=1048576
CONNECTOR_MAX_PAGES=3
CONNECTOR_MAX_EVENTS=100
CONNECTOR_RETRY_MAX=1
# Step 10: must stay true when ENVIRONMENT=production — startup fails fast if
# it is false, because connector credentials (client secret, Wazuh password,
# JWTs) would then cross the network without server verification.
CONNECTOR_VERIFY_TLS=true
# Phase 2 Step 5 controlled polling. The due-poll pass is OFF by default and
# nothing here starts a thread, timer or daemon: polling stays an explicit
# operator action unless an operator deliberately enables the pass.
CONNECTOR_AUTO_POLL_ENABLED=false
CONNECTOR_POLL_INTERVAL_SECONDS=300
CONNECTOR_FAILURE_COOLDOWN_SECONDS=60

# Step 28: bounded ingestion pipeline. Defaults are conservative and
# enforced server-side (ingest is operator-initiated only): fixed batch
# size, fixed in-process queue (overflow rejects new records and is
# audited), bounded retries for transient fetch failures only (auth and
# configuration failures are never retried), linear backoff. File-source
# byte resume stays off unless explicitly opted in; rotation, truncation
# and offset detection are always active. No scheduler, no streaming.
INGESTION_MAX_BATCH_SIZE=50
INGESTION_QUEUE_MAX=500
INGESTION_RETRY_MAX=1
INGESTION_RETRY_BACKOFF_SECONDS=0.25
CONNECTOR_FILE_RESUME=false

# Step 29: deterministic incident-intelligence bounds. Every value is a
# server-side ceiling that is never accepted from a client: the three
# rule windows (temporal chain, cross-source group, same-entity pairs)
# plus hard caps on events considered per analysis operation,
# relationships stored per incident, relationship evidence entries,
# evidence entries and timeline entries returned. Disabled rules are a
# server-side CSV of rule ids (unknown ids are ignored). Analysis runs
# only when an operator with MANAGE_INCIDENT calls the recalculate
# endpoint — there is no scheduler and no automatic scoring.
CORRELATION_TEMPORAL_WINDOW_MINUTES=60
CORRELATION_CROSS_SOURCE_WINDOW_MINUTES=60
CORRELATION_ENTITY_WINDOW_MINUTES=5
CORRELATION_MAX_EVENTS_PER_OPERATION=200
CORRELATION_RELATIONSHIP_MAX=200
CORRELATION_RELATIONSHIP_EVIDENCE_MAX=20
CORRELATION_EVIDENCE_MAX=200
CORRELATION_TIMELINE_MAX_ENTRIES=500
CORRELATION_DISABLED_RULES=

# Step 30: controlled defensive-response governance. Every value is a
# server-side ceiling or policy switch, never accepted from a client.
# Defensive actions are temporary by default: an approved action may
# never outlive RESPONSE_MAX_TTL_MINUTES, and a request that asks for no
# TTL gets RESPONSE_DEFAULT_TTL_MINUTES. There is deliberately no
# unlimited-TTL and no permanent-block option.
# RESPONSE_ALLOW_SELF_APPROVAL=false keeps separation of duties on even
# for a single-operator deployment; the role map already prevents an
# analyst from approving at all.
# RESPONSE_TARGET_EVIDENCE_REQUIRED=true means a response target must be
# justified by stored incident evidence - it is not a convenience switch
# to leave off in production.
# RESPONSE_PROVIDER names the single registry entry allowed to execute.
# MOCK is the only value that performs anything, and what it performs is
# a platform-side record. Set it to NOT_CONFIGURED to refuse every
# consequential action outright; that is the correct posture for any
# real Defender / firewall / endpoint / cloud integration, none of which
# is implemented or claimed here.
RESPONSE_MAX_TTL_MINUTES=1440
RESPONSE_DEFAULT_TTL_MINUTES=60
RESPONSE_ALLOW_SELF_APPROVAL=false
RESPONSE_MAX_ACTIONS_PER_INCIDENT=50
RESPONSE_TARGET_EVIDENCE_REQUIRED=true
RESPONSE_PROVIDER=MOCK

# Step 31: production hardening. Every value is a server-side ceiling or
# policy switch, never accepted from a client. See README section 12.
#
# ENV=production is a closed vocabulary (development|test|staging|
# production); an unknown value is rejected at startup rather than coerced.
# TRUSTED_HOSTS enables Host header validation - set it to the hostname(s)
# a deployment is actually served on. A wildcard is rejected everywhere.
# Step 10: TRUSTED_HOSTS is now MANDATORY when ENVIRONMENT=production. An
# empty list turns TrustedHostMiddleware into a no-op, so production refuses
# to start rather than silently serving without Host validation.
# BACKEND_CORS_ORIGINS must be set to the deployed frontend origins;
# production refuses to start if it still contains only the localhost
# development defaults, and refuses an empty list.
#
# Bounded database pool: total connections can never exceed
# DB_POOL_SIZE + DB_MAX_OVERFLOW, a caller waits at most
# DB_POOL_TIMEOUT_SECONDS for one, and DB_STATEMENT_TIMEOUT_MS stops a
# runaway statement server-side instead of holding a connection.
# MAX_REQUEST_BYTES refuses an over-sized body with 413 before it is
# buffered.
#
# Rate limits are deterministic fixed windows per calling identity
# (authenticated username, else client host). 0 disables a check. These
# are resource protection, not authorization: they never widen what an
# authenticated caller may do, and an unauthorized caller is refused
# 401/403 before any budget is consumed. They are in-process, so a
# multi-replica deployment enforces them per replica - see README
# section 12 known limitations.
ENV=development
TRUSTED_HOSTS=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RECOMPUTE=120
RATE_LIMIT_RECALCULATE=120
RATE_LIMIT_RISK_CALCULATE=120
RATE_LIMIT_CONNECTOR_POLL=60
RATE_LIMIT_RESPONSE_GOVERNANCE=300
RATE_LIMIT_SCAN_START=60
RATE_LIMIT_LOGIN_FAILURES=5
RATE_LIMIT_MAX_BUCKETS=10000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# Local dev convenience: direct backend DATABASE_URL (compose overrides this).
DATABASE_URL=postgresql+psycopg://secuser:changeme_in_env@localhost:5432/security_platform
