*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
*.db
*.sqlite
*.sqlite3
test_tmp.db
step26verify.db
.env
.env.*
!.env.example
alembic/README
.idea/
.vscode/
.git/
.gitignore
Dockerfile
.dockerignore
